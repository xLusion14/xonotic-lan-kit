<!-- Layout for the Xonotic Server panel (ServerPanel.cs loads this and wires up the named elements).
     iOS-style: grouped grey background, white rounded cards, system blue accents. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xonotic Server" Width="1040" Height="820" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F2F2F7"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="#1C1C1E"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Blue" Color="#007AFF"/>
    <SolidColorBrush x:Key="Fill" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="Secondary" Color="#8E8E93"/>
    <SolidColorBrush x:Key="Separator" Color="#E5E5EA"/>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="20,16"/>
      <Setter Property="Margin" Value="8"/>
      <Setter Property="Effect">
        <Setter.Value><DropShadowEffect BlurRadius="20" ShadowDepth="2" Direction="270" Opacity="0.07"/></Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Pill buttons: filled blue (primary), grey with blue text (secondary), red text (destructive) -->
    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Fill}"/>
      <Setter Property="Foreground" Value="{StaticResource Blue}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.65"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Background" Value="{StaticResource Blue}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="Destructive" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Foreground" Value="#FF3B30"/>
    </Style>

    <!-- Stepper (- value +) buttons -->
    <Style x:Key="Step" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Blue}"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Width" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" Padding="0,2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Rounded grey text fields -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Fill}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Chips: tap to select, the selected one turns blue -->
    <Style x:Key="Chips" TargetType="ListBox">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ItemsPanel">
        <Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="b" Background="{StaticResource Fill}" CornerRadius="15" Padding="14,6">
                    <ContentPresenter x:Name="c" TextElement.Foreground="#1C1C1E" TextElement.FontWeight="Medium"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#E5E5EA"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="b" Property="Background" Value="{StaticResource Blue}"/>
                      <Setter TargetName="c" Property="TextElement.Foreground" Value="White"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim rounded scrollbar instead of the classic Windows one -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Margin" Value="2,12,2,12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#C7C7CC" CornerRadius="3"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16,12,16,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header: title, status pill, start/stop -->
    <DockPanel Grid.Row="0" Margin="8,4,8,8" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Server" FontSize="32" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
        <Border x:Name="StatusPill" CornerRadius="13" Padding="12,4" Margin="16,6,0,0" VerticalAlignment="Center" Background="#FFE5E3">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#FF3B30" Margin="0,1,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Stopped" FontWeight="SemiBold" Foreground="#C4271D"/>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="StartButton" Content="Start Server" Style="{StaticResource Primary}"/>
        <Button x:Name="RestartServerButton" Content="Restart" Style="{StaticResource Pill}"/>
        <Button x:Name="StopButton" Content="Stop" Style="{StaticResource Destructive}" Margin="0"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: join info, game mode and map -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="HOW PLAYERS JOIN" Style="{StaticResource CardTitle}"/>
              <TextBlock x:Name="JoinText" Text="Start the server to see how players join." TextWrapping="Wrap"/>
              <DockPanel Margin="0,12,0,0">
                <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy" Style="{StaticResource Pill}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <Border Background="{StaticResource Fill}" CornerRadius="10" Padding="12,8">
                  <TextBlock x:Name="AddressText" Text="—" FontFamily="Cascadia Mono, Consolas" FontSize="17" FontWeight="SemiBold"/>
                </Border>
              </DockPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="NOW PLAYING" Style="{StaticResource CardTitle}"/>
              <TextBlock x:Name="NowPlayingText" Text="Not running" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock x:Name="NowPlayingDetail" Text="" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="GAME MODE" Style="{StaticResource CardTitle}"/>
              <ListBox x:Name="ModeChips" Style="{StaticResource Chips}"/>
              <TextBlock Text="MAP" Style="{StaticResource CardTitle}" Margin="0,8,0,10"/>
              <ListBox x:Name="MapChips" Style="{StaticResource Chips}"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="ChangeNowButton" Content="Change Now" Style="{StaticResource Primary}"/>
                <Button x:Name="RestartMatchButton" Content="Restart Match" Style="{StaticResource Pill}"/>
              </StackPanel>
              <TextBlock Text="Everyone moves to the new map together. Nobody is disconnected." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Right: players and settings -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="PlayersTitle" Text="PLAYERS" Style="{StaticResource CardTitle}"/>
              <ItemsControl x:Name="PlayersList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource Separator}" BorderThickness="0,0,0,1" Padding="0,7">
                      <StackPanel Orientation="Horizontal">
                        <Grid Width="30" Height="30" Margin="0,0,12,0">
                          <Ellipse Fill="{Binding Color}"/>
                          <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="NobodyText" Text="Nobody has joined yet." Style="{StaticResource Hint}"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="GAME SETTINGS" Style="{StaticResource CardTitle}"/>
              <Grid x:Name="SettingsGrid">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
              </Grid>
              <TextBlock Text="Server name" Margin="0,14,0,6"/>
              <TextBox x:Name="ServerNameBox"/>
              <TextBlock Text="Welcome message" Margin="0,12,0,6"/>
              <TextBox x:Name="WelcomeBox"/>
              <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="SaveButton" Content="Save Settings" Style="{StaticResource Primary}"/>
              </StackPanel>
              <TextBlock Text="Bots, server name and welcome message change right away. Limits and max players apply from the next map." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Server log, folded away -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,10">
      <Expander x:Name="LogExpander" Header="Server log">
        <TextBox x:Name="LogBox" Height="170" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
      </Expander>
    </Border>
  </Grid>
</Window>
